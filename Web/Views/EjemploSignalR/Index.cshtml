<script>
    let rut = null;
    let chat = null;
    let connection = null;

    document.addEventListener("DOMContentLoaded", () => alCargarPagina());

    function alCargarPagina()
    {
        const urlParams = new URLSearchParams(window.location.search);
        rut = urlParams.get("rut");

        if (rut) {
            console.log("El valor del parámetro rut es:", rut);
            conectarSignalR();
        }
        else {
            alert("El parámetro rut no está presente en la URL");
        }
    }

    function conectarSignalR()
    {
        connection = $.hubConnection("https://localhost:44353/signalr");
        chat = connection.createHubProxy("chatHub");

        connection.qs = { "rut": rut };  // Añadir el rut a la query string de la conexión

        chat.on("NotifyUser", (message) =>  // Recibir mensaje del servidor
        {
            if (message) {
                const messageObj = JSON.parse(message);
                console.log(messageObj);
                alert(JSON.stringify(messageObj, null, 2));
            }
        });

        connection.start().done(() =>
        {
            console.log("SignalR connected");

            chat.invoke("get_weather").catch((err) =>  // Pedir mensaje actual al servidor al conectar
            {
                console.error("Error invoking get_weather: " + err.toString());
            });
        })
        .fail((err) => {
            console.log("Could not connect: " + err);
        });
    }

    function enviarMensaje()
    {
        const recipientRut = document.getElementById("recipientRut").value;

        const message = {
            rut: recipientRut,
            data: document.getElementById("messageInput").value
        };

        chat.invoke('change_weather', JSON.stringify(message)).catch((err) => {
            console.error("Error invoking change_weather: " + err.toString());
        });
    }
</script>

<input type="text" id="recipientRut" placeholder="Recipient RUT" />
<input type="text" id="messageInput" placeholder="Enter message" />
<button onclick="enviarMensaje()">Enviar</button>
