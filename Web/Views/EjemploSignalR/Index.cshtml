<script>
    let rut = null;
    let chat = null;
    let connection = null;
    let isConnected = false;
    let hasLoggedDisconnect = false; // Para evitar múltiples logs de desconexión
    let identificadorUnico = generarIdentificadorUnico(); // Generar un identificador único para cada pantalla

    document.addEventListener("DOMContentLoaded", () => alCargarPagina());

    function alCargarPagina()
    {
        const urlParams = new URLSearchParams(window.location.search);
        rut = urlParams.get("rut");

        if (rut) {
            console.log("El valor del parámetro rut es:", rut);
            conectarSignalR();
        }
        else {
            alert("El parámetro rut no está presente en la URL");
        }
    }

    function conectarSignalR()
    {
        connection = $.hubConnection("https://localhost:44353/signalr");
        chat = connection.createHubProxy("chatHub");

        connection.qs = { "rut": rut, "identificadorUnico": identificadorUnico }; // Pasar rut y identificadorUnico

        chat.on("NotifyUser", (message) =>
        {
            if (message)
            {
                //alert("Esto se ejecuta solo durante el arranque de la página, cuando sí ha recibido un mensaje");

                try {
                    const messageObj = JSON.parse(message);
                    // Asegurarse de que el mensaje no se reciba en la misma pantalla (misma conexión)
                    if (messageObj.identificadorUnico !== identificadorUnico) {
                        console.log(messageObj);
                        alert(JSON.stringify(messageObj, null, 2));
                    }
                } catch (e) {
                    alert(message);
                }
            }
        });

        connection.start().done(() =>
        {
            isConnected = true;
            hasLoggedDisconnect = false;
            console.log("SignalR connected");

            chat.invoke("get_weather").done((result) => {
                if (result) {
                    const messageObj = JSON.parse(result);
                    if (messageObj && messageObj.mensajePrivado) {
                        alert(`Mensaje recibido: ${messageObj.mensajePrivado}`);
                    }
                }
            }).catch((err) => {
                console.error("Error invoking get_weather: " + err.toString());
            });
        })
        .fail((err) => {
            if (!hasLoggedDisconnect) {
                console.log("No se pudo conectar a SignalR. Intentando reconectar...");
                hasLoggedDisconnect = true;
            }
            isConnected = false;
            reconectarSignalR();
        });

        connection.disconnected(() =>
        {
            if (!hasLoggedDisconnect) {
                console.log("El backend dejó de estar disponible.");
                hasLoggedDisconnect = true;
            }
            isConnected = false;

            setTimeout(() => {
                console.log("Intentando reconectar a SignalR...");
                conectarSignalR();
            }, 5000);
        });
    }

    function reconectarSignalR()
    {
        setTimeout(() => {
            if (!isConnected) {
                console.log("Intentando reconectar a SignalR...");
                conectarSignalR();
            }
        }, 5000);
    }

    function enviarMensaje()
    {
        const rut = document.getElementById("recipientRut").value;
        const message = JSON.stringify({
            rut,
            mensaje: document.getElementById("messageInput").value,
            operacion: "enviar_mensaje_privado",
            identificadorUnico
        });

        if (chat && isConnected) {
            chat.invoke("change_weather", message).catch((err) => {
                console.error("Error invoking change_weather: " + err.toString());
            });
        } else {
            console.warn("No se pudo enviar el mensaje porque no hay conexión con SignalR.");
        }
    }

    function cerrarOtraSesion()
    {
        const rut = document.getElementById("recipientRut").value;
        const message = JSON.stringify({ rut, mensaje: "", operacion: "cerrar_otra_sesion", identificadorUnico });

        if (chat && isConnected) {
            chat.invoke("change_weather", message).catch((err) => {
                console.error("Error invoking change_weather: " + err.toString());
            });
        } else {
            console.warn("No se pudo cerrar la sesión porque no hay conexión con SignalR.");
        }
    }

    function abrirOtraSesion()
    {
        const rut = document.getElementById("recipientRut").value;
        const message = JSON.stringify({ rut, mensaje: "", operacion: "abrir_otra_sesion", identificadorUnico });

        if (chat && isConnected) {
            chat.invoke("change_weather", message).catch((err) => {
                console.error("Error invoking change_weather: " + err.toString());
            });
        } else {
            console.warn("No se pudo abrir la sesión porque no hay conexión con SignalR.");
        }
    }

    function generarIdentificadorUnico() {
        const randomPart = crypto.getRandomValues(new Uint32Array(1))[0];
        return Date.now().toString() + randomPart.toString();
    }


</script>

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-12 d-flex align-items-end justify-content-between">
                <h4 class="float-left heading h4-responsive mb-0">Ejemplo SignalR</h4>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-6">
                <div class="form-group">
                    <label>Rut</label>
                    <input type="text" id="recipientRut" placeholder="Ingrese rut" class="form-control">
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="form-group">
                    <label>Mensaje</label>
                    <input type="text" id="messageInput" placeholder="Ingrese mensaje" class="form-control" autocomplete="off">
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="row py-2 flex-row">
            <div class="col col-md-6 d-flex justify-content-start">
            </div>
            <div class="col col-md-6 d-flex justify-content-end">
                <button type="button" onclick="enviarMensaje()" class="btn btn-primary me-2">
                    <span>Enviar Mensaje</span>
                </button>

                <button type="button" onclick="cerrarOtraSesion()" class="btn btn-secondary">
                    <span>Cerrar Otra Sesion</span>
                </button>

                <button type="button" onclick="abrirOtraSesion()" class="btn btn-success">
                    <span>Abrir Otra Sesion</span>
                </button>
            </div>
        </div>
    </div>
</div>
