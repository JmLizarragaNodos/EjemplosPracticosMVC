    <div class="card-footer">
        <div class="row py-2 flex-row">

            <div class="col col-md-6  d-flex justify-content-start">

            </div>
            <div class="col col-md-6 d-flex justify-content-end">

                <button type="button" onclick="login()" class="btn btn-primary">Login</button>
                <button type="button" onclick="hacerPeticion()" class="btn btn-secondary">Hacer Petición</button>
                <button type="button" onclick="removerToken()" class="btn btn-primary">Remover Token</button>

            </div>
        </div>
    </div>
</div>

<script>

    (() =>
    {

    })();

    async function login()
    {
        try {
            let res = await httpPost({
                url: `@Url.Action("Login", "EjemploJwt")`,
                queryString: `username=jose&password=1234`
            });

            console.log(res);
            localStorage.setItem("prueba_jwt", res);
        }
        catch (ex) {
            console.log(ex);
        }
    }

    function removerToken() {
        localStorage.removeItem("prueba_jwt");
    }

    async function hacerPeticion()
    {
        try {
            let res = await httpPost({
                url: `@Url.Action("Probando", "EjemploJwt")`,
                queryString: `texto=asassaassa`
            });

            console.log(res);
        }
        catch (ex) {
            console.log(ex);
        }
    }

    function httpPost(datos)
    {
        return new Promise((resolve, reject) =>
        {
            let token = localStorage.getItem("prueba_jwt");

            fetch(datos.url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "Authorization": `Bearer ${token}`
                },
                body: datos.queryString
            })
            .then(response =>
            {
                if (response.ok)
                {
                    response.json().then(res =>
                    {
                        if (res.status == 200)
                            resolve(res.objeto);
                        else
                            reject(res);
                    });
                }
            })
            .catch(error => {
                reject("Ocurrió un error al obtener la información");
            });
        });
    }

</script>

